# Shared builder base: Python 3.12 + uv only (no app code, no deps).
# Optional local cache (service Dockerfiles embed this layer; CI does not need it):
#   docker build -f server/Dockerfile.base -t cygen/python-base:uv server/

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_LINK_MODE=copy \
    PATH="/root/.local/bin:${PATH}"

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/0.11.21/install.sh | sh \
    && ln -sf /root/.local/bin/uv /usr/local/bin/uv
